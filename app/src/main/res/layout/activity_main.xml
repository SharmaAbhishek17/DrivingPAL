<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="71dp"
            android:padding="10dp"
            android:text="DrivingPal Dashboard"
            android:background="blue"
            android:textColor="#333"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Service Control Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/startServiceBtn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="100dp"
                android:layout_marginEnd="5dp"
                android:backgroundTint="@android:color/holo_green_dark"
                android:text="Start\nDetection"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <Button
                android:id="@+id/stopServiceBtn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="100dp"
                android:layout_marginStart="5dp"
                android:backgroundTint="@android:color/holo_red_dark"
                android:text="Stop\nDetection"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Feature Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:divider="?android:attr/dividerHorizontal"
            android:showDividers="middle"
            android:dividerPadding="8dp">

            <Button
                android:id="@+id/addEmergencyBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Emergency Contact"
                android:visibility="visible" />

            <Button
                android:id="@+id/viewEmergencyBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="View Emergency Contacts" />

            <Button
                android:id="@+id/customizeSmsBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Customize SMS" />

            <Button
                android:id="@+id/testAccidentBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Test Accident Detection" />

            <Button
                android:id="@+id/enableDriveModeBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable Drive Mode Layout" />

            <Button
                android:id="@+id/testEmergencyAlertBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Test Emergency Alert Vibration" />

            <Button
                android:id="@+id/sendLocationBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Send Location to Emergency Contact" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
