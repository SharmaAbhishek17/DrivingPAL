<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- OUTER GLOW RING -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="160dp"
                android:centerColor="#553B82F6"
                android:endColor="#003B82F6"/>
        </shape>
    </item>

    <!-- MAIN BUTTON -->
    <item android:inset="20dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#3B82F6"
                android:endColor="#1E40AF"
                android:angle="45"/>
        </shape>
    </item>

</layer-list>